{
  "name": "alephscript-mcp-model-sdk",
  "version": "1.0.0",
  "description": "A fork from Oasis-AI-42 & a wrapper for alephscript-mcp-mesh-sdk so 42 is EmCiPiraized, :-D",
  "main": "ai_service_standalone.mjs",
  "type": "module",

  "scripts": {

    "start": "npm run start:gpu",
    "start:gpu": "start_gpu.bat",
    "start:gpu-safe": "start_gpu_safe.bat",
    "start:cpu": "start_cpu.bat",
    "start:gpu-conservative": "start_gpu.bat",
    "start:gpu-max": "start_gpu_max.bat",
    "start:auto": "start_auto_gpu.bat",

    "query:prod": "cd plugins/node_llama_cpp_functions && sh node_llama_cpp_handler_test.sh",
    "query:prod:mcp": "cd plugins/node_llama_cpp_functions && sh node_llama_cpp_mcp_handler_test.sh",

    "query:dev": "cd plugins/llama_functions && sh llama_functions_handler_test.sh",
    "query:dev:mcp": "cd plugins/llama_functions && sh llama_functions_mcp_handler_test.sh",

    "query:oasis:mcp": "cd plugins/oasis_driver  && sh query.simple.mcp.sh",

    "gpu:local": "cd plugins && node node_llama_cpp_handler_test.mjs",
    "gpu:llama": "cd plugins && node llama_functions_handler_test.mjs",
    
    "gpu:check": "cd plugins && node -e \"import('./gpu_diagnostics.mjs').then(async (module) => { const { quickGPUCheck } = module; await quickGPUCheck(); }).catch(console.error);\"",
    "gpu:test-simple": "cd plugins && node test_gpu_simple.mjs",
    "gpu:test-simple-functions": "cd plugins && node test_simple_functions.mjs",
    
    "test:local-model": "cd plugins && node test_gpu_simple.mjs",
    "test:functions": "cd plugins && node test_simple_functions.mjs",
    "test:all-gpu": "npm run gpu:check && npm run gpu:test-simple && npm run test:functions",
    "llama:dryrun": "node plugins/system/llama_dryrun.mjs",
    
    "experimental:inpsector:target": "node plugins/mcp_query_server.mjs",
    "test:mcp": "node plugins/test_mcp_integration.mjs",
    
    "diagnostic": "npm run gpu:check",
    "benchmark": "npm run gpu:test-simple && npm run test:functions",
    "verify-gpu": "npm run gpu:check && echo 'Running GPU verification...' && npm run gpu:test-simple",
    
    "help": "sh ./help.sh",
    "info": "sh ./help.sh",
    "ai:start": "node /src/AI/ai_service_standalone.mjs",
    "ai:health": "curl -s http://localhost:4001/health | jq .",
    "ai:status": "curl -s http://localhost:4001/status | jq .",
    "ai:test": "curl -s -X POST http://localhost:4001/ai -H 'Content-Type: application/json' -d '{\"input\":\"Hello AI, are you working?\"}' | jq .",
    "ai:logs": "docker-compose logs -f oasis-server-dev | grep 'AI Service'",

    "mcp:list": "start http://localhost:4001/ai/ui/mcp/list"

  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "node-llama-cpp": "^3.13.0",
    "ollama": "^0.5.18",
    "@modelcontextprotocol/sdk": "^1.18.1",
    "commander": "^12.0.0"
  },
  "keywords": [
    "ai",
    "llama",
    "gpu",
    "cuda",
    "machine-learning",
    "node-llama-cpp",
    "oasis",
    "function-calling",
    "local-models"
  ],
  "author": "",
  "license": "AIPLv1",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git", 
    "url": ""
  }
}
